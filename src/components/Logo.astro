---
import { Image } from "astro:assets";
import config from "@config/config.json";
import { BiPlanet } from "react-icons/bi/index.js";

const { src } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo?: string;
  logo_width?: any;
  logo_height?: any;
  logo_text: string;
  title: string;
} = config.site;
---

<a
  href={import.meta.env.BASE_URL}
  class="navbar-brand group inline-flex items-center gap-2.5 text-xl font-primary font-medium leading-none tracking-normal hover:[&_img]:brightness-110"
>
  <span
    class="inline-flex shrink-0 items-center text-gray-500 transition-colors duration-200 group-hover:text-primary dark:text-gray-400"
    aria-hidden="true"
  >
    <BiPlanet size={22} />
  </span>
  <span class="flex items-center text-dark transition-colors duration-200 group-hover:text-primary dark:text-stone-200">
    {
      src || logo ? (
        <Image
          width={logo_width.replace("px", "") * 2}
          height={logo_height.replace("px", "") * 2}
          src={src ? src : logo}
          alt={title}
          style={{
            height: logo_height.replace("px", "") + "px",
            width: logo_width.replace("px", "") + "px",
          }}
        />
      ) : logo_text ? (
        <span>{logo_text}</span>
      ) : (
        title
      )
    }
  </span>
</a>
