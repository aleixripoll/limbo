---
interface Props {
  baseUrl: string;
  years: number[];
  currentYear: number | null; // null = "All"
  /** Link for the "Tots" option; defaults to baseUrl (home). */
  allHref?: string;
  /** Render greyed-out and non-interactive (e.g. while another filter is active). */
  disabled?: boolean;
}

const { baseUrl, years, currentYear, allHref, disabled = false } = Astro.props;
---
<div class:list={["year-filter mb-4 flex flex-wrap items-center gap-2", disabled && "opacity-50"]}>
  <span class="text-sm text-(--color-muted) mr-1">Any:</span>
  <div class="filter-select-wrap">
    <select
      class:list={["filter-select", disabled && "cursor-not-allowed"]}
      aria-label="Filter by year"
      data-year-filter
      disabled={disabled}
    >
      <option value={allHref ?? baseUrl} {...(currentYear === null && { selected: true })}>Tots</option>
      {years.map((y) => (
        <option value={`${baseUrl}year/${y}/`} {...(currentYear === y && { selected: true })}>
          {y}
        </option>
      ))}
    </select>
  </div>
</div>
<script>
  // Delegated listener: survives astro view transitions (scripts run once; DOM is swapped).
  document.addEventListener("change", (e) => {
    const target = e.target;
    if (!(target instanceof HTMLSelectElement)) return;
    if (!target.matches("[data-year-filter]")) return;
    if (target.value) window.location.href = target.value;
  });
</script>
