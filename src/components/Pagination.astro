---
interface Props {
  /** e.g. `authors` for `/authors/page/2`; omit for home post listing */
  section?: string;
  currentPage: number;
  totalPages: number;
}

const { section, currentPage, totalPages } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;

function hrefForPage(n: number): string {
  if (!section) {
    if (n <= 1) return baseUrl;
    return `${baseUrl}page/${n}`;
  }
  const sect = section.replace(/^\/+|\/+$/g, "");
  if (n <= 1) return `${baseUrl}${sect}`;
  return `${baseUrl}${sect}/page/${n}`;
}

const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Paginació">
      {currentPage > 1 && (
        <a href={hrefForPage(currentPage - 1)} class="pagination-link pagination-prev">
          ← Anterior
        </a>
      )}

      <div class="pagination-jump">
        <span class="pagination-jump-label">Pàgina</span>
        <div class="pagination-page-select" data-page-select>
          <button
            type="button"
            class="pagination-page-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
            data-page-trigger
          >
            <span>{currentPage}</span>
            <svg
              class="pagination-page-chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <ul class="pagination-page-list" role="listbox" data-page-list hidden>
            {pageNumbers.map((n) => (
              <li
                role="option"
                aria-selected={n === currentPage}
                data-href={hrefForPage(n)}
                class:list={[
                  "pagination-page-option",
                  n === currentPage && "pagination-page-option--selected",
                ]}
              >
                {n}
              </li>
            ))}
          </ul>
        </div>
        <span class="pagination-jump-of">de {totalPages}</span>
      </div>

      {currentPage < totalPages && (
        <a href={hrefForPage(currentPage + 1)} class="pagination-link pagination-next">
          Següent →
        </a>
      )}
    </nav>
  )
}

<script is:inline>
  let paginationDocBound = false;

  function closeAllPageSelects() {
    document.querySelectorAll("[data-page-select]").forEach((root) => {
      const list = root.querySelector("[data-page-list]");
      const trigger = root.querySelector("[data-page-trigger]");
      if (list) list.hidden = true;
      if (trigger) trigger.setAttribute("aria-expanded", "false");
    });
  }

  function initPageSelects() {
    document.querySelectorAll("[data-page-select]").forEach((root) => {
      if (root.dataset.pageBound === "1") return;
      root.dataset.pageBound = "1";

      const trigger = root.querySelector("[data-page-trigger]");
      const list = root.querySelector("[data-page-list]");
      if (!trigger || !list) return;

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const willOpen = list.hidden;
        closeAllPageSelects();
        if (willOpen) {
          list.hidden = false;
          trigger.setAttribute("aria-expanded", "true");
        }
      });

      list.querySelectorAll("[data-href]").forEach((opt) => {
        opt.addEventListener("click", () => {
          const href = opt.getAttribute("data-href");
          if (href) window.location.href = href;
        });
      });
    });

    if (!paginationDocBound) {
      paginationDocBound = true;
      document.addEventListener("click", closeAllPageSelects);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAllPageSelects();
      });
    }
  }

  initPageSelects();
  document.addEventListener("astro:page-load", initPageSelects);
</script>
