---
import { Image } from "astro:assets";
import config from "@config/config.json";
import { humanize } from "@lib/utils/textConverter";
import CategoryGridIcon from "@components/CategoryGridIcon";

const { summary_length } = config.settings;

interface Props {
  className?: string;
  posts: any;
  fluid?: boolean;
  /** "gallery" renders just the image, no title/description/categories.
   *  "list" renders a text list of links with a thumbnail and description. */
  variant?: "default" | "gallery" | "list";
}

const { className, posts, fluid, variant = "default" } = Astro.props;
---

{variant === "list" ? (
  <ul class={`simple-post-list mt-6 ${className || ""}`}>
    {
      posts.map((post: any) => (
        <li class="simple-post-item">
          <a href={`${import.meta.env.BASE_URL}${post.id}`} class="simple-post-link">
            <div class="simple-post-image-container">
              {post.data.image ? (
                <Image
                  class="simple-post-image"
                  src={post.data.image}
                  alt={post.data.title}
                  widths={[80, 130]}
                  sizes="80px 130px"
                  quality={80}
                  loading="lazy"
                />
              ) : (
                <div class="simple-post-image-placeholder" aria-hidden="true">
                  {post.data.title?.slice(0, 1)?.toUpperCase() ?? "?"}
                </div>
              )}
            </div>
            <div class="simple-post-text">
              <span class="simple-post-title">{post.data.title}</span>
              {post.data.description && (
                <p class="simple-post-description">{post.data.description}</p>
              )}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
) : (
<div class={`masonry-grid mt-6 ${variant === "default" ? "masonry-grid--compact" : ""} ${variant === "gallery" ? "masonry-grid--gallery" : ""} ${className || ""}`}>
  {
    posts.map((post: any, i: number) => (
      <article class="masonry-item" data-post-slug={post.id}>
        <a
          href={`${import.meta.env.BASE_URL}${post.id}`}
          class="masonry-card group"
          aria-label={`Llegir article: ${post.data.title}`}
        >
          <div class="masonry-image-container">
            {post.data.image ? (
              <Image
                class="masonry-image"
                src={post.data.image}
                alt={post.data.title}
                widths={[320, 480, 640, 828, 1080]}
                sizes="(max-width: 539px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw"
                quality={80}
                loading="lazy"
              />
            ) : (
              <div class="masonry-card-placeholder" aria-hidden="true">
                {post.data.title?.slice(0, 1)?.toUpperCase() ?? "?"}
              </div>
            )}
          </div>

          {variant === "default" && (
            <div class="masonry-content">
              {post.data.categories && (
                <div class="masonry-categories">
                  <CategoryGridIcon className="masonry-icon" />
                  {post.data.categories.map((category: any, i: number) => (
                    <span class="masonry-category">
                      {humanize(category)}{i !== post.data.categories.length - 1 && ","}
                    </span>
                  ))}
                </div>
              )}

              <h3 class="masonry-title">{post.data.title}</h3>

              {
                (post.data.description || post.body) && (
                  <p class="masonry-excerpt">
                    {post.data.description
                      ? post.data.description
                      : post.body?.slice(
                          0,
                          Number(i < 2 && fluid != false ? summary_length * 2 : summary_length)
                        ) + "..."}
                  </p>
                )
              }
            </div>
          )}
        </a>
      </article>
    ))
  }
</div>
)}
