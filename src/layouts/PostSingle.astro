---
import { Image } from "astro:assets";
import { render } from "astro:content";
//import Share from "@components/Share.astro";
// getSinglePage import removed (not used)
import dateFormat from "@lib/utils/dateFormat";
import { humanize, markdownify, slugify } from "@lib/utils/textConverter";
import CategoryGridIcon from "@components/CategoryGridIcon";
import { BiCalendar, BiPlus, BiSolidChevronUpCircle, BiX } from "react-icons/bi/index.js";
import Disqus from "@components/Disqus";
//const allAuthors = await getSinglePage("authors");
const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, categories, image, image_attribution, date, tags } = post.data;

const lastModifiedIso = remarkPluginFrontmatter.lastModified as string | undefined;
const isDrawingsPost = categories.some((category: string) => slugify(category) === "dibuixos");
const isPortraitCover = image && image.height > image.width;
---

<section class="section pt-4 md:pt-16 lg:pt-18">
  <div class="layout-container max-w-[800px]">
    <article class="row justify-center -mx-4">
      <header class="col-12 md:col-10 post-header">
        <div class:list={["post-heading-layout", { "post-heading-layout--portrait": isPortraitCover }]}>
      {(image || image_attribution) && (
        <div class={`post-heading-cover mb-6 ${isDrawingsPost ? "flex justify-center" : ""}`}>
          {
            image && (
              <button
                type="button"
                class="cover-zoom-trigger mx-auto block max-w-full border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4"
                aria-label={`Ampliar: ${title}`}
                aria-haspopup="dialog"
                aria-controls="cover-zoom"
                title="Ampliar imatge"
              >
              <Image
                src={image}
                widths={[320, 480, 640, 828, 1080]}
                quality={80}
                sizes={`(max-width: 640px) 100vw, 800px`}
                alt={title}
                class={
                  isDrawingsPost
                    ? "post-cover-image sm:rounded-lg object-scale-down mx-auto post-cover-image--drawings"
                    : "post-cover-image sm:rounded-lg h-auto w-auto max-w-full object-scale-down block mx-auto"
                }
                style={isDrawingsPost ? undefined : {
                  "--post-cover-width": `${image.width}px`,
                  "--post-cover-height": `${image.height}px`,
                }}
              />
              <span class="cover-zoom-indicator" aria-hidden="true">
                <BiPlus className="h-6 w-6" />
              </span>
              </button>
            )
          }
          {image_attribution && (
              <a target="_blank" href={post.data.image_attribution.url} class="attribution">
                Foto de {post.data.image_attribution.author} a {post.data.image_attribution.site}
              </a>
          )}
        </div>
      )}

      <div class="post-heading-text text-center">
        <h1 set:html={markdownify(title)} class="text-[1.625rem] md:text-[2rem] mt-0 mb-1 font-medium dark:text-gray-300" />
        <p class="pt-1 pb-3 text-[22px] md:text-2xl font-light leading-relaxed">{description}</p>
        <ul class="pt-1 flex flex-wrap items-center justify-center text-base font-light text-gray-500 dark:text-gray-400">
          {/*<li class="mx-3">
            {
              allAuthors
                .filter((author: any) =>
                  authors
                    .map((author: string) => slugify(author))
                    .includes(slugify(author.data.title))
                )
                .map((author: any) => (
                  <a
                    href={`${import.meta.env.BASE_URL}authors/${slugify(author.id)}`}
                    class="flex items-center font-medium hover:text-primary"
                  >
                    {author.data.image && (
                      <Image
                        src={author.data.image}
                        alt={author.data.title}
                        height={50}
                        width={50}
                        class="mr-2 h-6 w-6 rounded-full"
                      />
                    )}
                    <BiUser className="mr-1 h-[18px] w-[18px]" />
                    <span>{author.data.title}</span>
                  </a>
                ))
            }
          </li>*/}
          <li class="pb-2 mx-2 flex flex-wrap items-center">
            <BiCalendar className="mr-2 h-[18px] w-[18px] shrink-0 text-current" aria-hidden="true" />
            {date ? dateFormat(date) : lastModifiedIso ? dateFormat(lastModifiedIso) : ""}
          </li>
          <li class="group pb-2 mx-2 flex flex-wrap items-center">
            <CategoryGridIcon className="mr-2 h-[18px] w-[18px] shrink-0 text-current transition-colors group-hover:text-primary" />
            <>
              <ul>
                {
                  categories.map((category: string, i: number) => (
                    <li class="inline-block">
                      <a
                        href={`${import.meta.env.BASE_URL}categories/${slugify(category)}`}
                        class="mr-1 transition-colors hover:text-primary"
                      >
                        {humanize(category)}{i !== post.data.categories.length - 1 && ","}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </>
          </li>
        </ul>
        {tags.length > 0 && (
          <ul class="mt-4 mb-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
            {tags.map((tag: string) => (
              <li class="flex items-center">
                <a
                  href={`${import.meta.env.BASE_URL}tags/${slugify(tag)}`}
                  class="text-sm italic dark:text-gray-400 hover:text-primary"
                >
                  <span class="mr-0.5">#</span>{humanize(tag, { capitalizeFirst: false })}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
        </div>
      </header>

      <div class="md:col-10">
        <div class={`content mb-16 text-left ${isDrawingsPost ? "content--drawings" : ""}`}>
          <Content />
        </div>
          {/* <Share
            className="social-share mb-4"
            title={title}
            description={description}
            slug={post.id}
          />*/}
      </div>
    </article>
    <Disqus className="mt-20" client:load />
  </div>
</section>

{image && (
  <dialog id="cover-zoom" class="cover-zoom" aria-label={title}>
    <button type="button" class="cover-zoom-close" aria-label="Tancar" title="Tancar" autofocus>
      <BiX className="h-7 w-7" />
    </button>
    <Image
      src={image}
      widths={[640, 1080, 1600, 2400]}
      sizes="100vw"
      quality={90}
      alt={title}
      class="cover-zoom-image"
      loading="lazy"
    />
  </dialog>
)}

<!-- similar posts -->
<!--{
  similarPosts.length > 0 && (
    <section class="section pt-0">
      <div class="layout-container">
        <h1 class="h3 mb-8 text-center uppercase font-light">Articles similars</h1>
        <SimilarPosts posts={similarPosts.slice(0, 4)} />
      </div>
    </section>
  )
}-->

<button
  id="scroll-to-top"
  class="fixed bottom-6 right-4 lg:right-20 xl:right-52 2xl:right-80 hidden whitespace-nowrap rounded-full opacity-80 bg-none hover:bg-primary hover:text-white"><BiSolidChevronUpCircle className="h-[50px] w-[50px]"/>
</button>

<script is:inline>
  // Initialize all functionality when DOM is ready
  function initializePage() {
    // Only add heading links if we're on a post page (check if scroll-to-top button exists)
    function addHeadingLinks() {
      // Only add heading links if we're on a post page
      if (!document.querySelector("#scroll-to-top")) {
        return;
      }
      
      // Only target headings within the main post content area
      let headings = Array.from(
        document.querySelectorAll(".content h1, .content h2, .content h3, .content h4")
      );
      for (let heading of headings) {
        if (!heading.id) {
          continue;
        }
        // Check if heading already has an anchor link to avoid duplicates
        if (heading.querySelector(".heading-link")) {
          continue;
        }
        
        heading.classList.add("group");
        let link = document.createElement("a");
        link.innerText = "#";
        link.className =
          "heading-link hidden group-hover:inline-block hover:text-primary ml-2 text-light no-underline";
        link.href = "#" + heading.id;
        link.ariaHidden = "true";
        heading.appendChild(link);
      }
    }
    
    // Scroll to top functionality
    function initScrollToTop() {
      const scrollButton = document.querySelector("#scroll-to-top");
      if (!scrollButton) return;
      
      // Show/hide button based on scroll position
      function scrollFunction() {
        if (
          document.body.scrollTop > 400 ||
          document.documentElement.scrollTop > 400
        ) {
          scrollButton.style.display = "block";
        } else {
          scrollButton.style.display = "none";
        }
      }
      
      // Add scroll event listener
      window.addEventListener("scroll", scrollFunction);
      
      // Add click event listener
      scrollButton.addEventListener("click", () => {
        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      });
      
      // Initial check for scroll position
      scrollFunction();
    }
    
    function initCoverZoom() {
      const trigger = document.querySelector(".cover-zoom-trigger");
      const dialog = document.querySelector("#cover-zoom");
      if (!trigger || !dialog || dialog.dataset.bound) return;
      dialog.dataset.bound = "true";
      const zoomScreens = window.matchMedia("(min-width: 768px)");
      function syncZoomAvailability() {
        trigger.disabled = !zoomScreens.matches;
        trigger.title = zoomScreens.matches ? "Ampliar imatge" : "";
        if (!zoomScreens.matches) dialog.close();
      }
      syncZoomAvailability();
      zoomScreens.addEventListener("change", syncZoomAvailability);
      async function closeCoverZoom() {
        if (!dialog.open || dialog.dataset.closing) return;
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          dialog.dataset.closing = "true";
          const animations = dialog.querySelector(".cover-zoom-image").getAnimations();
          await Promise.allSettled(animations.map((animation) => animation.finished));
        }
        dialog.close();
        delete dialog.dataset.closing;
      }
      trigger.addEventListener("click", () => {
        if (zoomScreens.matches) dialog.showModal();
      });
      dialog.querySelector(".cover-zoom-close").addEventListener("click", closeCoverZoom);
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeCoverZoom();
      });
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeCoverZoom();
        }
      });
      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeCoverZoom();
      });
      document.addEventListener("astro:before-swap", () => {
        zoomScreens.removeEventListener("change", syncZoomAvailability);
        dialog.close();
      }, { once: true });
    }

    // Initialize all functions
    addHeadingLinks();
    initScrollToTop();
    initCoverZoom();
  }
  
  // Wait for DOM to be ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializePage);
  } else {
    // DOM is already ready
    initializePage();
  }
  
  // Also handle navigation events for SPA-like behavior
  document.addEventListener("astro:page-load", initializePage);
</script>
