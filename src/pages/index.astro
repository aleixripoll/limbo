---
import Base from "@layouts/Base.astro";
import Posts from "@layouts/Posts.astro";
import { getSinglePage } from "@lib/contentParser.astro";
import { getTaxonomy } from "@lib/taxonomyParser.astro";
import taxonomyFilter from "@lib/utils/taxonomyFilter";
import { sortByDate } from "@lib/utils/sortFunctions";
import { humanize } from "@lib/utils/textConverter";
import { BiCategoryAlt, BiTime } from "react-icons/bi/index.js";

const categories = await getTaxonomy("posts", "categories");
const posts = await getSinglePage("posts");
const baseUrl = import.meta.env.BASE_URL;

const latestPosts = sortByDate(posts).slice(0, 4);

const sections = categories
  .map((category) => {
    const isDibuixos = category === "dibuixos";
    const sorted = sortByDate(taxonomyFilter(posts, "categories", category));
    return {
      category,
      title: humanize(category || ""),
      posts: sorted.slice(0, 4),
      variant: isDibuixos ? ("gallery" as const) : ("list" as const),
    };
  })
  .sort((a, b) => (a.category === "dibuixos" ? -1 : b.category === "dibuixos" ? 1 : 0));
---

<Base>
  <section class="section">
    <div class="layout-container">
      <div class="mb-16">
        <div class="mb-4 flex items-center gap-3">
          <h2 class="h3 flex items-center gap-2 text-gray-500">
            <BiTime className="h-6 w-6 shrink-0" />
            Més recents
          </h2>
          <a
            href={`${baseUrl}posts`}
            class="self-center whitespace-nowrap rounded-lg bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-500 transition hover:bg-primary hover:text-white"
          >
            Veure més →
          </a>
        </div>
        <Posts posts={latestPosts} fluid={false} variant="list" />
      </div>
      {
        sections.map((section) => (
          <div class="mb-16">
            <div class="mb-4 flex items-center gap-3">
              <h2 class="h3 flex items-center gap-2 text-gray-500">
                <BiCategoryAlt className="h-6 w-6 shrink-0" />
                {section.title}
              </h2>
              <a
                href={`${baseUrl}categories/${section.category}`}
                class="self-center whitespace-nowrap rounded-lg bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-500 transition hover:bg-primary hover:text-white"
              >
                Veure més →
              </a>
            </div>
            <Posts posts={section.posts} fluid={false} variant={section.variant} />
          </div>
        ))
      }
    </div>
  </section>
</Base>
