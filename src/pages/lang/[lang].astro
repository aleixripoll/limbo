---
import Base from "@layouts/Base.astro";
import { getSinglePage } from "@lib/contentParser.astro";
import Posts from "@layouts/Posts.astro";
import YearFilter from "@components/YearFilter.astro";
import LangFilter from "@components/LangFilter.astro";
import { sortByDate } from "@lib/utils/sortFunctions";

export async function getStaticPaths() {
  const allPosts = await getSinglePage("posts");
  const langs = [...new Set(allPosts.map((p: any) => p.data.lang).filter(Boolean))].sort();
  const years = [...new Set(allPosts.map((p: any) => p.data.date.getFullYear()))].sort((a: any, b: any) => b - a);
  return langs.map((lang) => {
    const posts = sortByDate(allPosts.filter((p: any) => p.data.lang === lang));
    return {
      params: { lang: String(lang) },
      props: { posts, lang, langs, years },
    };
  });
}

const { posts, lang, langs, years } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<Base>
  <section class="section">
    <div class="layout-container">
      <div class="flex flex-wrap items-center gap-x-8">
        <YearFilter baseUrl={baseUrl} allHref={`${baseUrl}posts`} years={years} currentYear={null} disabled />
        <LangFilter baseUrl={baseUrl} allHref={`${baseUrl}posts`} langs={langs} currentLang={lang} />
      </div>
      <Posts className="mb-8 md:mb-16" posts={posts} />
    </div>
  </section>
</Base>
